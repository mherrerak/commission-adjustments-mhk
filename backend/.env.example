# ============================================================
# CONFIGURACIÓN DE ENTORNO - Commission Manager
# Copiar este archivo como .env y completar los valores
# ============================================================

# --- Base de datos ---
DATABASE_PATH=./data/comisiones.db

# --- Configuración SMTP para envío de emails ---
# Gmail: smtp.gmail.com:587
# Outlook: smtp.office365.com:587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_cuenta@gmail.com
# Para Gmail: usa una "App Password" (no tu contraseña normal)
# Ir a: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=tu_app_password
SMTP_USE_TLS=true

# --- Destinatario de notificaciones ---
EMAIL_DESTINATARIO=mherrerak@falabella.com

# --- Remitente (puede ser igual al SMTP_USER) ---
EMAIL_REMITENTE=comisiones@tuempresa.com
EMAIL_REMITENTE_NOMBRE=Sistema de Comisiones

# --- Scheduler / Cron ---
# Hora de Chile: GMT-4 (ajustar según DST si es necesario)
# El cron corre en UTC, así que 7:00 AM Chile (UTC-4) = 11:00 AM UTC
CRON_HORA_UTC=11
CRON_MINUTO=0

# --- Días de aviso preventivo antes del vencimiento ---
DIAS_AVISO_VENCIMIENTO=2

# --- Responsables del equipo (separados por coma) ---
RESPONSABLES=Matías Herrera,Ana García,Carlos López,María Martínez,Pedro Soto

# --- Puerto del servidor ---
PORT=8000

# --- Ambiente (development / production) ---
AMBIENTE=development
